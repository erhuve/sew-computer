{
  "name": "sew-computer",
  "private": true,
  "type": "module",
  "workspaces": ["apps/web"],
  "scripts": {
    "test": "bun test packages apps/api",
    "test:engine": "bun test services/engine",
    "typecheck": "tsc --noEmit",
    "build": "cd apps/web && bun run build",
    "studio": "bun run build && bun scripts/serve-studio.ts",
    "demo": "bun run build && bun scripts/serve-visual-demo.ts",
    "test:browser": "playwright test",
    "check:docs": "python3 scripts/check_docs.py"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "hono": "^4.10.6",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.34.5",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3"
  }
}
