{
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "esnext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {"@/*": ["apps/web/src/*"]}
  },
  "include": ["apps/api/**/*.ts", "apps/web/src/**/*.ts", "apps/web/src/**/*.tsx", "apps/web/server.ts", "packages/**/*.ts", "services/engine/*.ts", "tests/**/*.ts", "playwright.config.ts"],
  "exclude": ["**/node_modules", "**/dist"]
}
